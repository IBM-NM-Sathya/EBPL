from PIL import Image
import random

def encrypt_image(input_path, output_path, key):
    try:
        img = Image.open(input_path)
        pixels = img.load()
        width, height = img.size

        print(f"🔒 Encrypting image of size {width}x{height} with key = {key}...")

        for x in range(width):
            for y in range(height):
                r, g, b = pixels[x, y]

                # Apply simple mathematical operation to encrypt
                r = (r + key) % 256
                g = (g + key) % 256
                b = (b + key) % 256

                pixels[x, y] = (r, g, b)

        img.save(output_path)
        print(f"✅ Image encrypted and saved as: {output_path}")

    except Exception as e:
        print("❌ Error:", e)


def decrypt_image(input_path, output_path, key):
    try:
        img = Image.open(input_path)
        pixels = img.load()
        width, height = img.size

        print(f"🔓 Decrypting image of size {width}x{height} with key = {key}...")

        for x in range(width):
            for y in range(height):
                r, g, b = pixels[x, y]

                # Reverse the operation
                r = (r - key) % 256
                g = (g - key) % 256
                b = (b - key) % 256

                pixels[x, y] = (r, g, b)

        img.save(output_path)
        print(f"✅ Image decrypted and saved as: {output_path}")

    except Exception as e:
        print("❌ Error:", e)


def main():
    print("=" * 45)
    print("🔐 Image Encryption & Decryption Tool")
    print("=" * 45)

    while True:
        print("\nChoose an option:")
        print("1. Encrypt Image")
        print("2. Decrypt Image")
        print("3. Exit")
        choice = input("Enter choice (1/2/3): ")

        if choice == '1':
            input_file = input("Enter input image path (e.g., image.jpg): ")
            output_file = input("Enter output (encrypted) image path: ")
            key = int(input("Enter numeric key for encryption (1-255): "))
            encrypt_image(input_file, output_file, key)

        elif choice == '2':
            input_file = input("Enter encrypted image path: ")
            output_file = input("Enter output (decrypted) image path: ")
            key = int(input("Enter the same key used for encryption: "))
            decrypt_image(input_file, output_file, key)

        elif choice == '3':
            print("👋 Exiting...")
            break

        else:
            print("❌ Invalid choice! Please choose 1, 2, or 3.")


if __name__ == "__main__":
    main()